#include <windows.h>

1 RT_MANIFEST "app/WidgetStudio.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WidgetStudio\0"
            VALUE "FileDescription", "WidgetStudio native desktop widgets\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "InternalName", "WidgetStudio\0"
            VALUE "OriginalFilename", "WidgetStudio.exe\0"
            VALUE "ProductName", "WidgetStudio\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
